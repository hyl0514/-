# 复制为 .env.local 后按需填写（.env.local 不要提交到 git）

# ---------- 后端接口 ----------
# 前端请求前缀，默认 /api（生产环境可填完整域名，如 https://api.example.com/api）
VITE_API_BASE=/api
# 开发环境 Vite 代理目标：本地 Spring Boot 服务
VITE_PROXY_TARGET=http://localhost:3200

# ---------- 高德地图 ----------
# 申请地址：https://console.amap.com/dev/key/app
# 未配置时行程规划页自动进入本地演示模式，不会报错
VITE_AMAP_KEY=
# 2021 年 12 月后创建的 Key 需要配置安全密钥
VITE_AMAP_SECURITY_CODE=

# ---------- AI 大模型（硅基流动） ----------
# 接入后端后，建议把 Key 放到后端配置，前端不再保存
VITE_AI_API_KEY=
VITE_AI_BASE_URL=https://api.siliconflow.cn/v1
VITE_AI_MODEL=deepseek-ai/DeepSeek-V3
